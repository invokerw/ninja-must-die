  "local_patches": [
    {
      "file": "node/psd.js",
      "reason": "Canonicalize the report root before comparing it with the realpath returned by psd_server.js; macOS /var and /private/var aliases otherwise prevent readiness detection."
    },
    {
      "file": "node/psd.js",
      "reason": "Include the imported runtime dependency closure in code identity and snapshots so resume rejects changes to retry or harmonization behavior."
    },
    {
      "file": "node/bbox_detection_cache_checks.js",
      "reason": "Update the detector fixture to read multimodal user content after the imported core added a system message; keep all detection assertions unchanged."
    },
    {
      "file": "node/model_config.js",
      "reason": "Import public Codex defaults with explicit project/environment overrides; expose protocol and credential presence without importing Codex authentication tokens."
    },
    {
      "file": "node/controller_client.js",
      "reason": "Adapt multimodal Chat-shaped controller requests and Responses results while preserving reasoning, structured output, refusal and truncation semantics."
    },
    {
      "file": "node/layerforge.js",
      "reason": "Use the protocol adapter when constructing model clients; leave images.edit routing independent."
    },
    {
      "file": "node/bbox_recursive_core.js",
      "reason": "An unsupported reasoning override is explicitly disabled so the adapter cannot reintroduce the configured reasoning setting."
    },
    {
      "file": "node/psd.js",
      "reason": "Snapshot public Codex controller defaults across child processes and resumes; include protocol modules and dependency locks in run identity."
    },
    {
      "file": "package.json",
      "reason": "Pin smol-toml for standards-compliant Codex configuration parsing."
    },
    {
      "file": "package-lock.json",
      "reason": "Lock the added TOML parser."
    },
    {
      "file": "node/model_doctor.js",
      "reason": "Provide local diagnostics, explicit online capability probes, model listing and redacted failure reporting."
    },
    {
      "file": "node/codex_config.js",
      "reason": "Resolve the selected custom gateway API bearer or environment credential at runtime, bind it to the original endpoint and provider, and keep secrets out of serializable defaults."
    },
    {
      "file": "node/model_config.js",
      "reason": "Reuse bound gateway credentials after explicit key overrides; allow independent image models to follow the same Codex gateway without copying secrets."
    },
    {
      "file": "node/model_doctor.js",
      "reason": "Report credential origin and reuse blocks without exposing secrets; distinguish API bearer reuse from Codex login sessions."
    }
  ]
