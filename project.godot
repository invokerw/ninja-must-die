; Engine configuration file.
; Generated for the first playable control slice of 影刃疾行.

config_version=5

[application]

config/name="影刃疾行"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0666667, 0.0941176, 0.14902, 1)
